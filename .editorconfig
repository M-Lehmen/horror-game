# Einheitliche Formatierung für alle Editoren und KIs
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot-Standard: Tabs in GDScript und Shadern
[*.{gd,gdshader}]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,py}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
